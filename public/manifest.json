{
  "manifest_version": 3,
  "name": "SyncUp Outreach",
  "short_name": "SyncUp",
  "version": "0.1.0",
  "description": "Find hiring teams. Start conversations. Human-in-the-loop hiring outreach assistant for LinkedIn.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "SyncUp Outreach",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.supabase.co/*", "https://api.anthropic.com/*"],
  "content_scripts": [
    { "matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
