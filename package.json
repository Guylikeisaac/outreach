{
  "name": "syncup-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SyncUp Outreach \u2014 human-in-the-loop hiring prospect discovery for LinkedIn (Chrome MV3).",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && tsc --noEmit && vite build && vite build --config vite.worker.config.ts && vite build --config vite.content.config.ts",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:ui": "vite --open /preview.html"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
